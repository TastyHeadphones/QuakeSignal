{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quakesignal-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "QuakeRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuakeRelay"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quakesignal-production",
      "database_id": "834fba5c-0d99-4398-9565-18c6858eb2a8",
      "migrations_dir": "migrations"
    }
  ]
}
