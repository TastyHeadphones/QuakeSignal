{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quakesignal-terminal-dlq-monitor-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  // This is an isolated escalation rehearsal. It still has no public route.
  "workers_dev": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "MONITOR_TARGET": "staging"
  },
  "secrets": {
    "required": [
      "CLOUDFLARE_TARGET_ACCOUNT_ID",
      "CLOUDFLARE_MONITOR_API_TOKEN",
      "GITHUB_APP_ID",
      "GITHUB_APP_INSTALLATION_ID",
      "GITHUB_APP_PRIVATE_KEY_PKCS8"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
