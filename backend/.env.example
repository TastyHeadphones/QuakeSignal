PORT=8080
DB_PATH=./data/quakesignal.sqlite

# APNs (Apple Push Notification service) auth — see backend/README.md for how
# to generate these from the Apple Developer portal.
APNS_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.quakesignal.app
# false while testing with a Debug build signed for the Sandbox APNs
# environment, true only for TestFlight/App Store builds.
APNS_PRODUCTION=false

# Comma-separated subset of: jma_eew,sc_eew,cenc_eew,fj_eew,cq_eew,cenc_eqlist,jma_eqlist
# Defaults to all of them if unset.
WOLFX_SOURCES=jma_eew,sc_eew,cenc_eew,fj_eew,cq_eew,cenc_eqlist,jma_eqlist

LOG_LEVEL=info
