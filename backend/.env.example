PORT=8080
DB_PATH=./data/quakesignal.sqlite

# Optional local-only APNs experiment. Leave unset for ordinary development.
# Never place a UniSphereco production/TestFlight .p8 key here and never set
# APNS_PRODUCTION=true. Production APNs credentials belong only in Cloudflare
# Worker secrets; see docs/RELEASE_SECRETS.md.
APNS_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.quakesignal.app
# This legacy local harness supports sandbox-only experiments.
APNS_PRODUCTION=false

# Comma-separated subset of: jma_eew,sc_eew,cenc_eew,fj_eew,cq_eew,cenc_eqlist,jma_eqlist
# Defaults to all of them if unset.
WOLFX_SOURCES=jma_eew,sc_eew,cenc_eew,fj_eew,cq_eew,cenc_eqlist,jma_eqlist

LOG_LEVEL=info
